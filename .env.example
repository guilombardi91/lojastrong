# ATENÇÃO AO DEPLOY: só as duas variáveis NEXT_PUBLIC_* precisam existir
# durante o `docker build` — elas viram texto dentro do bundle do cliente e não
# são segredo. Todas as demais são de RUNTIME e nunca devem ser passadas como
# --build-arg: o EasyPanel imprime o comando de build inteiro no log, em texto
# claro, e qualquer senha ali vira credencial vazada. O Dockerfile já não
# declara ARG para nenhuma delas.

# Banco de dados — PostgreSQL (o schema usa provider = "postgresql").  [runtime]
DATABASE_URL="postgresql://usuario:senha@localhost:5432/loja_strong?schema=public"

# Assina os tokens de sessão. Quem tem esta chave forja uma sessão de admin sem
# precisar de senha — trate como a credencial mais sensível do projeto. Trocá-la
# derruba todas as sessões abertas, o que é justamente o que se quer depois de
# um vazamento.  [runtime]
# Gere um valor novo com:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""

# sandbox simula a aprovação numa tela interna, sem precisar de credenciais.
# Troque para "mercadopago" e preencha as chaves abaixo para cobrar de verdade.
PAYMENT_PROVIDER="sandbox"
MP_ACCESS_TOKEN=""
NEXT_PUBLIC_MP_PUBLIC_KEY=""
MP_WEBHOOK_SECRET=""
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Sem SMTP_HOST, os avisos de "voltou ao estoque" só são logados no console
# em vez de enviados — útil para testar o fluxo sem uma conta de e-mail.
# Abaixo, os valores do Microsoft 365 / Office 365 (STARTTLS na porta 587).
# A caixa precisa ter o SMTP AUTH liberado no tenant e, com MFA ativo, usar
# uma senha de aplicativo em SMTP_PASS.
SMTP_HOST="smtp.office365.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="no-reply@suaempresa.com.br"
SMTP_PASS=""
# O Microsoft 365 recusa remetente diferente do SMTP_USER — só troque se a
# conta tiver permissão "Enviar como" sobre o endereço usado aqui.
SMTP_FROM="Loja Strong <no-reply@suaempresa.com.br>"
