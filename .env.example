DATABASE_URL="file:./dev.db"

# Gere um valor novo com:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""

# sandbox simula a aprovação numa tela interna, sem precisar de credenciais.
# Troque para "mercadopago" e preencha as chaves abaixo para cobrar de verdade.
PAYMENT_PROVIDER="sandbox"
MP_ACCESS_TOKEN=""
NEXT_PUBLIC_MP_PUBLIC_KEY=""
MP_WEBHOOK_SECRET=""
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Sem SMTP_HOST, os avisos de "voltou ao estoque" só são logados no console
# em vez de enviados — útil para testar o fluxo sem uma conta de e-mail.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Loja Strong <no-reply@strong.com.br>"
